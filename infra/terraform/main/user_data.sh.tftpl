#!/bin/bash
set -euxo pipefail

dnf install -y docker jq
systemctl enable --now docker

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  https://github.com/docker/compose/releases/download/v2.39.2/docker-compose-linux-$(uname -m)
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
fi
swapon --show=NAME | grep -qx /swapfile || swapon /swapfile
grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab

mkdir -p /opt/outline/releases /opt/outline/state

cat > /opt/outline/instance.env <<'EOF'
AWS_REGION=${region}
ECR_REGISTRY=${ecr_registry}
DEPLOY_BUCKET=${deploy_bucket}
BACKUP_BUCKET=${backup_bucket}
ATTACHMENTS_BUCKET=${attachments_bucket}
DOMAIN=${domain}
EOF
chmod 644 /opt/outline/instance.env

cat > /etc/systemd/system/outline-backup.service <<'EOF'
[Unit]
Description=Outline Postgres backup to S3

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/outline/current/backup.sh daily
EOF

cat > /etc/systemd/system/outline-backup.timer <<'EOF'
[Unit]
Description=Daily Outline backup

[Timer]
OnCalendar=*-*-* 19:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now outline-backup.timer
